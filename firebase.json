{
    "firestore": {
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    },
    "dataconnect": {
        "source": "dataconnect"
    },
    "functions": {
        "predeploy": [
            "npm --prefix \"$RESOURCE_DIR\" run lint"
        ],
        "source": "server"
    },
    "hosting": {
        "predeploy": [
            "node scripts/generate-env-www.js"
        ],
        "public": "www",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**",
            "**/*.php"
        ],
        "headers": [
            {
                "source": "**/*.@(html|js|css|json)",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache"
                    }
                ]
            },
            {
                "source": "**/*.@(png|jpg|jpeg|svg|gif|ico|webp|woff|woff2)",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=86400"
                    }
                ]
            }
        ],
        "rewrites": [
            {
                "source": "/api/**",
                "function": "api"
            },
            {
                "source": "/login",
                "destination": "/login.html"
            },
            {
                "source": "/l",
                "destination": "/login.html"
            }
        ]
    }
}