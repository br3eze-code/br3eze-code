# ═══════════════════════════════════════════════════════════════════
# AgentOS — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ═══════════════════════════════════════════════════════════════════
# .env.example - Add these to your existing AgentOS .env

# Stripe (International Card Payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Get credentials from: https://www.pesapal.com/zw/business

# Consumer Key and Secret from PesaPay Dashboard
PESAPAY_CONSUMER_KEY=your_consumer_key_here
PESAPAY_CONSUMER_SECRET=your_consumer_secret_here

# Environment: 'sandbox' for testing, 'production' for live
PESAPAY_ENV=sandbox

# Your webhook URL for IPN (Instant Payment Notifications)
PESAPAY_CALLBACK_URL=https://yourdomain.com/webhooks/pesapay

# IPN ID (obtained after registering IPN URL - will be auto-set)
PESAPAY_IPN_ID=

# EcoCash (Zimbabwe Mobile Money)
ECOCASH_MERCHANT_CODE=YOUR_MERCHANT_CODE
ECOCASH_API_KEY=your_ecocash_api_key
ECOCASH_ENV=sandbox  # or 'production'

# NetOne OneMoney (Zimbabwe Mobile Money)
NETONE_API_KEY=your_netone_api_key
NETONE_MERCHANT_ID=your_merchant_id

# PayNow (Zimbabwe Payment Aggregator)
PAYNOW_INTEGRATION_ID=your_integration_id
PAYNOW_INTEGRATION_KEY=your_integration_key
PAYNOW_RESULT_URL=https://yourdomain.com/webhooks/paynow
PAYNOW_RETURN_URL=https://yourdomain.com/payment/success

# Apple Pay
APPLE_PAY_MERCHANT_ID=merchant.com.yourdomain.agentos
APPLE_PAY_CERT_PATH=./certs/apple_pay_cert.pem
APPLE_PAY_KEY_PATH=./certs/apple_pay_key.pem
APPLE_PAY_DOMAIN=yourdomain.com

# Google Pay
GOOGLE_PAY_MERCHANT_ID=your_google_merchant_id
GOOGLE_PAY_MERCHANT_NAME=AgentOS
GOOGLE_PAY_ENV=TEST  # or 'PRODUCTION'

# Webhook Base URL
WEBHOOK_BASE_URL=https://yourdomain.com
# Android/Play Store
ANDROID_PACKAGE_NAME=com.company.game
GOOGLE_PLAY_SERVICE_ACCOUNT=/secrets/play-service-account.json

# Nintendo Switch
NINTENDO_SDK_ROOT=/opt/Nintendo/SDK

HORDE_URL=https://horde.company.com
HORDE_TOKEN=xxx # from Horde profile > API tokens
P4PORT=ssl:perforce.company.com:1666
P4USER=agentos
P4CLIENT=agentos_ue_ws
P4PASSWD=xxx # or use p4 login

DRIVER_UNREAL_ENABLED=true
UNREAL_UAT_PATH=/opt/UnrealEngine/Engine/Build/BatchFiles/RunUAT.sh
UNREAL_EDITOR_PATH=/opt/UnrealEngine/Engine/Binaries/Linux/UnrealEditor
UNREAL_REMOTE_PY=http://ue-editor:30010
UNREAL_PROJECT_ROOT=/workspace/unreal

FRAMEIO_TOKEN=xxx # from Frame.io dev portal
SHOTGRID_URL=https://studio.shotgrid.autodesk.com
SHOTGRID_SCRIPT=AgentOS
SHOTGRID_KEY=xxx

DRIVER_BLENDER_ENABLED=true
BLENDER_SD_API=http://localhost:7860/sdapi/v1/txt2img # Automatic1111 or ComfyUI

DRIVER_DAHUA_ENABLED=true
# Per-device creds better in Vault. For simple setup:
DRIVER_DAHUA_USER=admin
DRIVER_DAHUA_PASSWORD=use_gcp_secret_manager_in_prod

DRIVER_DATADOG_ENABLED=true
DRIVER_DATADOG_API_KEY=...
DRIVER_DATADOG_APP_KEY=...


DRIVER_GCP_ENABLED=true
GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json

DRIVER_PAGERDUTY_ENABLED=true
DRIVER_PAGERDUTY_API_TOKEN= # REST API v2 token with incidents:write

DRIVER_MACOS_ENABLED=true
DRIVER_MACOS_USER=agentos
DRIVER_MACOS_PRIVATE_KEY=-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----
DRIVER_MACOS_SUDO_PASSWORD= # only if you need sudo and don't use NOPASSWD

DRIVER_SLACK_ENABLED=true
DRIVER_SLACK_BOT_TOKEN=xoxb-...
DRIVER_SLACK_SIGNING_SECRET=...
DRIVER_SLACK_APP_TOKEN=xapp-... # for Socket Mode

DRIVER_LINUX_ENABLED=true
DRIVER_LINUX_USER=agentos
DRIVER_LINUX_PRIVATE_KEY=-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----
DRIVER_LINUX_SUDO_PASSWORD= # or use NOPASSWD in sudoers

# ── MikroTik Router ─────────────────────────────────────────────────
MIKROTIK_IP=192.168.88.1
MIKROTIK_USER=admin
MIKROTIK_PASS=
MIKROTIK_PORT=8728

# ── Telegram Bot ────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
WHATSAPP_ENABLED=true

# ── AI Providers (set whichever you use) ────────────────────────────
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── Gateway and API ──────────────────────────────────────────────────
AGENTOS_GATEWAY_TOKEN=          # generate in production; do not log or commit
AGENTOS_GATEWAY_URL=
AGENTOS_API_BASE_URL=
AGENTOS_API_VERSION=v1
AGENTOS_API_BASE_PATH=/api/v1
AGENTOS_API_REQUIRE_AUTH=true
AGENTOS_DASHBOARD_URL=
SERVER_PORT=3000
SERVER_HOST=0.0.0.0
GATEWAY_TLS_ENABLED=false
GATEWAY_TLS_CERT_PATH=
GATEWAY_TLS_KEY_PATH=
GATEWAY_TRUST_PROXY=false

# ── Voucher / Billing ───────────────────────────────────────────────
# Prefix prepended to all generated voucher codes (e.g. VCH, NET, ISP)
VOUCHER_PREFIX=VCH
# Comma-separated plan names — must match MikroTik hotspot profile names
VOUCHER_PLANS=default,1day,7day,30day

# ── Brand / Operator Identity ───────────────────────────────────────
# Displayed in receipts, Mastercard A2A metadata, and the AI agent greeting
BRAND_SERVICE_NAME=AgentOS Hotspot
BRAND_RECIPIENT_NAME=AgentOS

# ── Mastercard A2A Commerce (optional) ─────────────────────────────
MASTERCARD_CONSUMER_KEY=
MASTERCARD_KEY_ALIAS=
MASTERCARD_KEY_PASSWORD=
MASTERCARD_P12_PATH=

# ── Firebase (optional — leave blank to use local SQLite) ───────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=
FIREBASE_WEB_API_KEY=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# ── Durable local persistence and fallbacks ──────────────────────────
SQLITE_PATH=./data/agentos.sqlite
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_FALLBACK_ENABLED=true
SQLITE_NATIVE_REQUIRED=false
PAYMENT_IDEMPOTENCY_STORE=sqlite
WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300

# ── Profile ─────────────────────────────────────────────────────────
# 'default' uses ~/.agentos; any other value uses ~/.agentos-<profile>
AGENTOS_PROFILE=default
LOG_LEVEL=info
# Generate with: openssl rand -base64 48
JWT_SECRET=

# ── Runtime and security defaults ────────────────────────────────────
AGENTOS_ENV=development
AGENTOS_DATA_DIR=./data
AGENTOS_LOG_DIR=./logs
AGENTOS_CONFIG_DIR=~/.agentos
AGENTOS_DEFAULT_TENANT_ID=default
AGENTOS_DEFAULT_DOMAIN=general
AGENTOS_DEFAULT_SITE_ID=
AGENTOS_ONBOARDING_WBS_ENABLED=true
AGENTOS_ONBOARDING_PAIRING_TTL_MS=600000
AGENTOS_ONBOARDING_DEFAULT_CHANNEL=telegram
AGENTOS_ONBOARDING_SPECIALIST_ID=
AGENTOS_ONBOARDING_SESSION_STORE=memory
AGENTOS_STORYLINE_BASE_PATH=
AGENTOS_API_PASSWORD=
AGENTOS_ADMIN_PASSWORD=
AGENTOS_OPERATOR_PASSWORD=
AGENTOS_READONLY_PASSWORD=
BACKUP_PASSWORD=
AGENTOS_APPROVAL_TIMEOUT_MS=300000

# ── Storyline/session state ──────────────────────────────────────────
AGENTOS_STORYLINE_SESSION_TTL_MS=86400000
AGENTOS_STORYLINE_MAX_CACHE_ENTRIES=100
AGENTOS_STORYLINE_COMPACT_KEEP_LAST=20
AGENTOS_STORYLINE_MODE=isolated
AGENTOS_STORYLINE_SUMMARY_MAX_CHARS=50
AGENTOS_STORYLINE_SUMMARY_LABEL=Previous conversation summary
AGENTOS_CONFIG_FILE=
AGENTOS_AUDIT_RETENTION_DAYS=365
AGENTOS_ENCRYPTION_KEY=

# ── AI model router and metering ─────────────────────────────────────
# Neutral provider IDs: openai, anthropic, gemini, ollama, openrouter, custom
PRIMARY_PROVIDER=gemini
FALLBACK_PROVIDERS=claude,ollama
AI_ROUTER_MODE=failover
AI_DEFAULT_MODEL=
AI_REASONING_MODEL=
AI_EMBEDDING_MODEL=
AI_MAX_INPUT_TOKENS=32768
AI_MAX_OUTPUT_TOKENS=4096
AI_USAGE_METERING_ENABLED=true
AI_USAGE_STORE=sqlite
AI_USAGE_CURRENCY=USD
AI_MONTHLY_BUDGET_CENTS=0
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# ── OAuth identity linking ──────────────────────────────────────────
OAUTH_ENABLED=true
OAUTH_REDIRECT_BASE_URL=http://localhost:3000
OAUTH_SESSION_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=

# AI Providers (Configure at least one)


# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-preview-05-20

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

# Ollama (Local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_URL=

# WhatsApp (Baileys)
WHATSAPP_ENABLED=true
WHATSAPP_SESSION_NAME=agentos-session

# Discord (Optional)
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# Slack (Optional)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Gateway Settings
GATEWAY_PORT=3000
GATEWAY_HOST=0.0.0.0
HEARTBEAT_INTERVAL=1800000

# Security
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# MCP (Model Context Protocol)
MCP_ENABLED=true
MCP_SERVER_PORT=3001

# ── Session & Memory ────────────────────────────────────────────────
SESSION_MODE=isolated
MEMORY_BASE_PATH=./data/sessions
SKILLS_PATH=./src/skills
