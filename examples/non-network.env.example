# Copy to .env for a non-network AgentOS deployment.
# Never commit real credentials.
AGENTOS_DOMAIN=retail

# Configure only the model/provider(s) you use.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# Optional channels. Leave empty when unused.
TELEGRAM_TOKEN=
TELEGRAM_BOT_TOKEN=

# Persistence selection: auto, firebase, supabase, or local according to your deployment.
DATABASE_PROVIDER=local
DATA_BACKEND=local
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Router/network settings intentionally blank for non-network domains.
MIKROTIK_HOST=
MIKROTIK_IP=
MIKROTIK_USER=
MIKROTIK_PASS=
MIKROTIK_PORT=
ROS_HOST=
ROS_PORT=
ROS_USER=
ROS_PASS=
