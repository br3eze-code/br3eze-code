{
  "name": "br3eze-code",
  "version": "2026.8.5",
  "description": "AgentOS — Network Intelligence Operating System for MikroTik via AI",
  "main": "src/core/gateway.js",
  "bin": {
    "agentos": "./bin/agentos.js",
    "agentos-esm": "./agentos.mjs"
  },
  "scripts": {
    "start": "node bin/agentos.js gateway",
    "start:modern": "node agentos.mjs",
    "desktop": "electron desktop/main.js",
    "desktop:dev": "electron desktop/main.js",
    "desktop:pack": "electron-builder --dir",
    "desktop:dist": "electron-builder --win nsis",
    "automate": "pm2 start scripts/automate.js --name agentos-ops",
    "start:all": "npm run start & npm run automate",
    "dev": "nodemon bin/agentos.js --dev",
    "setup": "node bin/agentos.js onboard",
    "security:audit": "npm audit && node scripts/security-check.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "lint": "eslint .",
    "lint:ci": "eslint src/core/PluginManager.js src/core/WorkflowEngine.js src/plugins/custom/*.js scripts/check-syntax.mjs --quiet",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "build": "tsc --project tsconfig.json",
    "build:android": "cordova build android",
    "build:android:release": "cordova build android --release -- --gradleArg=-PcdvReleaseSigningPropertiesFile=C:\\Users\\user\\br3eze-code\\platforms\\android\\release-signing.properties",
    "build:ios": "cordova build ios",
    "db:migrate": "node scripts/migrate-vouchers.js",
    "build:check": "node scripts/check-syntax.mjs",
    "postinstall": "node scripts/agentos-postinstall.mjs",
    "preuninstall": "node scripts/preuninstall.js",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/br3eze-code/br3eze-code.git"
  },
  "files": [
    "bin/",
    "src/",
    "desktop/",
    "agentos.mjs",
    "main.js",
    "scripts/installer-init.mjs",
    "scripts/agentos-postinstall.mjs",
    "install.sh",
    "install.ps1",
    "README.md",
    "LICENSE"
  ],
  "build": {
    "appId": "com.br3eze.agentos",
    "productName": "AgentOS",
    "extraMetadata": {
      "main": "desktop/main.js"
    },
    "artifactName": "agentos-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "files": [
      "desktop/**/*",
      "bin/**/*",
      "src/**/*",
      "www/**/*",
      "agentos.mjs",
      "main.js",
      "package.json",
      "!**/*.map",
      "!**/test{,s}/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "executableName": "agentos"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AgentOS"
    }
  },
  "keywords": [
    "mikrotik",
    "routeros",
    "hotspot",
    "network-management",
    "telegram-bot",
    "ai-agent",
    "gemini",
    "agentos",
    "wifi-billing",
    "starlink"
  ],
  "author": "MZACANA / Br3eze Africa",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@aws-sdk/client-ec2": "^3.1035.0",
    "@aws-sdk/client-s3": "^3.1035.0",
    "@clack/prompts": "^1.3.0",
    "@google-cloud/compute": "^6.9.0",
    "@google-cloud/vertexai": "^1.12.0",
    "@google/generative-ai": "^0.24.1",
    "@kubernetes/client-node": "^1.4.0",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/rest": "^22.0.1",
    "@slack/bolt": "^5.0.0",
    "axios": "^1.17.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.8.0",
    "boxen": "^7.1.1",
    "chalk": "^4.1.2",
    "cheerio": "^1.2.0",
    "commander": "^12.1.0",
    "compression": "^1.7.4",
    "compromise": "^14.16.0",
    "cordova-plugin-bluetooth-serial": "^0.4.7",
    "cors": "^2.8.6",
    "cron-parser": "^5.6.2",
    "debug": "^4.4.3",
    "digest-fetch": "^3.1.1",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.1",
    "express": "*",
    "express-rate-limit": "8.5.1",
    "express-validator": "^7.3.2",
    "firebase": "^12.13.0",
    "firebase-admin": "^14.2.0",
    "form-data": "^4.0.5",
    "franc": "^6.2.0",
    "google-auth-library": "^10.6.2",
    "googleapis": "^173.0.0",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "ink": "^5.2.1",
    "ink-text-input": "^6.0.0",
    "inquirer": "^8.2.7",
    "ioredis": "^5.3.2",
    "joi": "^18.1.2",
    "js-yaml": "^4.3.0",
    "jsonwebtoken": "^9.0.2",
    "midi-writer-js": "^3.2.1",
    "morgan": "^1.10.0",
    "node-cache": "^5.1.2",
    "node-telegram-bot-api": "^1.2.0",
    "node-thermal-printer": "^4.6.0",
    "nodemailer": "^9.0.5",
    "onvif": "^0.8.1",
    "openai": "^4.52.0",
    "ora": "^5.4.1",
    "osc": "^2.4.5",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pdf-lib": "1.17.1",
    "pdf-parse": "^2.4.5",
    "pino": "^8.17.0",
    "pm2": "^7.0.3",
    "prom-client": "^15.1.3",
    "puppeteer-core": "25.7.0",
    "python-shell": "^5.0.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "rate-limiter-flexible": "^5.0.0",
    "react": "^18.3.1",
    "routeros-client": "^1.1.1",
    "serialport": "^13.0.0",
    "simple-plist": "^1.3.1",
    "speakeasy": "^2.0.0",
    "ssh2": "^1.17.0",
    "tonal": "^6.4.3",
    "twilio": "^5.0.0",
    "undici": "^6.24.0",
    "uuid": "^14.0.0",
    "winston": "^3.19.0",
    "ws": "^8.21.0",
    "xml-js": "^1.6.11",
    "xml2js": "^0.6.2",
    "xss-clean": "^0.1.4",
    "xterm": "^5.3.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.3",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-private-methods": "^7.18.6",
    "@babel/preset-env": "^7.23.3",
    "@babel/preset-react": "^7.22.15",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^14.1.0",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^19.0.1",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "clean-css": "^5.3.3",
    "community-cordova-plugin-wifi-wizard": "^3.4.0",
    "cordova": "^13.0.0",
    "cordova-android": "^15.0.0",
    "cordova-browser": "^7.0.0",
    "cordova-plugin-aicore": "file:custom-plugins/cordova-plugin-aicore",
    "cordova-plugin-android-permissions": "^1.1.5",
    "cordova-plugin-camera": "^8.0.0",
    "cordova-plugin-device": "^3.0.0",
    "cordova-plugin-firebasex": "^20.0.2",
    "cordova-plugin-inappbrowser": "^6.0.0",
    "cordova-plugin-local-notification": "^1.2.3",
    "cordova-plugin-network-information": "^3.0.0",
    "cordova-plugin-network-tools": "file:custom-plugins/cordova-plugin-network-tools",
    "cordova-plugin-screen-orientation": "^3.0.4",
    "cordova-plugin-vibration": "^3.1.1",
    "cordova-plugin-wifi-billing-agent": "file:custom-plugins/cordova-plugin-wifi-billing-agent",
    "cordova-sqlite-storage": "^7.0.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint-config-prettier": "*",
    "eslint-plugin-prettier": "*",
    "javascript-obfuscator": "^5.4.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.2.5",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3"
  },
  "cordova": {
    "platforms": [
      "browser",
      "android"
    ],
    "plugins": {
      "cordova-plugin-oauth": {},
      "cordova-plugin-contacts": {},
      "cordova-plugin-aicore": {},
      "cordova-plugin-wifi-billing-agent": {},
      "cordova-plugin-android-permissions": {},
      "community-cordova-plugin-wifi-wizard": {},
      "cordova-plugin-device": {},
      "cordova-plugin-network-information": {},
      "cordova-plugin-firebasex": {},
      "cordova-plugin-local-notification": {},
      "cordova-plugin-vibration": {},
      "cordova-plugin-screen-orientation": {},
      "cordova-plugin-camera": {},
      "cordova-plugin-inappbrowser": {},
      "cordova-sqlite-storage": {},
      "cordova-plugin-network-tools": {},
      "cordova-plugin-bluetooth-serial": {}
    }
  },
  "optionalDependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc.9"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/br3eze-code"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.claude/worktrees/"
    ],
    "collectCoverageFrom": [
      "src/core/*.js",
      "src/utils/*.js",
      "adapters/*.js",
      "agents/*.js",
      "tools/system/*.js"
    ],
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "testTimeout": 15000
  },
  "overrides": {
    "osc": {
      "ws": "8.21.0"
    },
    "pm2": {
      "js-yaml": "4.3.1"
    }
  }
}
