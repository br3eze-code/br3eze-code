<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0" id="cordova-plugin-wifi-billing-agent" version="4.0.0">

    <name>WiFi Billing Agent</name>
    <description>Complete WiFi billing system with multi-agent architecture, gossip protocols, and AI orchestration</description>
    <license>MIT</license>
    <keywords>cordova,wifi,billing,agent,gossip,mesh,ai,orchestration,powerconnect</keywords>

    <js-module src="www/WiFiBillingAgent.js" name="WiFiBillingAgent">
        <clobbers target="WiFiBillingAgent" />
        <clobbers target="cordova.plugins.WiFiBillingAgent" />
    </js-module>

    <!-- WiFiWizard2 Compatibility Layer -->
    <js-module src="www/WiFiWizard2Compat.js" name="WiFiWizard2Compat">
        <clobbers target="WifiWizard2" />
        <clobbers target="cordova.plugins.WifiWizard2" />
    </js-module>

    <!-- Core Agent System -->
    <js-module src="www/agents/CoreAgent.js" name="CoreAgent">
        <runs />
    </js-module>
    <js-module src="www/agents/EventBus.js" name="EventBus">
        <runs />
    </js-module>
    <js-module src="www/agents/StateManager.js" name="StateManager">
        <runs />
    </js-module>

    <!-- WiFi Agent -->
    <js-module src="www/agents/WiFiAgent.js" name="WiFiAgent">
        <runs />
    </js-module>
    <js-module src="www/agents/ConnectionManager.js" name="ConnectionManager">
        <runs />
    </js-module>
    <js-module src="www/agents/NetworkScanner.js" name="NetworkScanner">
        <runs />
    </js-module>

    <!-- Billing Agent -->
    <js-module src="www/agents/BillingAgent.js" name="BillingAgent">
        <runs />
    </js-module>
    <js-module src="www/agents/UsageTracker.js" name="UsageTracker">
        <runs />
    </js-module>
    <js-module src="www/agents/RateCalculator.js" name="RateCalculator">
        <runs />
    </js-module>

    <!-- Auth Agent -->
    <js-module src="www/agents/AuthAgent.js" name="AuthAgent">
        <runs />
    </js-module>

    <!-- Notification Agent -->
    <js-module src="www/agents/NotificationAgent.js" name="NotificationAgent">
        <runs />
    </js-module>

    <!-- AI Orchestrator -->
    <js-module src="www/agents/AIOrchestrator.js" name="AIOrchestrator">
        <runs />
    </js-module>

    <!-- Gossip Protocol -->
    <js-module src="www/protocols/GossipNode.js" name="GossipNode">
        <runs />
    </js-module>
    <js-module src="www/protocols/PeerManager.js" name="PeerManager">
        <runs />
    </js-module>
    <js-module src="www/protocols/VectorClock.js" name="VectorClock">
        <runs />
    </js-module>

    <!-- Utilities -->
    <js-module src="www/utils/CryptoUtils.js" name="CryptoUtils">
        <runs />
    </js-module>
    <js-module src="www/utils/Logger.js" name="Logger">
        <runs />
    </js-module>
    <js-module src="www/utils/NetworkUtils.js" name="NetworkUtils">
        <runs />
    </js-module>

    <!-- Android Platform -->
    <platform name="android">
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="WiFiBillingAgent">
                <param name="android-package" value="com.wifibilling.agent.WiFiBillingAgentPlugin"/>
            </feature>
            <!-- WiFiWizard2 compatibility feature -->
            <feature name="WifiWizard2">
                <param name="android-package" value="com.wifibilling.agent.WiFiBillingAgentPlugin"/>
                <param name="onload" value="true" />
            </feature>
        </config-file>

        <config-file target="AndroidManifest.xml" parent="/*">
            <!-- Location Permissions -->
            <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
            <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
            <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

            <!-- WiFi Permissions -->
            <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
            <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
            <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
            <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

            <!-- Foreground Service -->
            <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
            <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

            <!-- Notifications -->
            <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

            <!-- Boot -->
            <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

            <!-- Wake Lock -->
            <uses-permission android:name="android.permission.WAKE_LOCK" />
        </config-file>

        <config-file target="AndroidManifest.xml" parent="/manifest/application">
            <!-- Main Plugin Service -->
            <service android:name="com.wifibilling.agent.WiFiBillingService" android:enabled="true" android:exported="false" android:foregroundServiceType="connectedDevice" />

            <!-- Gossip Protocol Service -->
            <service android:name="com.wifibilling.agent.GossipService" android:enabled="true" android:exported="false" />

            <!-- Session Monitor Service -->
            <service android:name="com.wifibilling.agent.SessionMonitorService" android:enabled="true" android:exported="false" android:foregroundServiceType="dataSync" />

            <!-- Boot Receiver -->
            <receiver android:name="com.wifibilling.agent.BootReceiver" android:enabled="true" android:exported="true">
                <intent-filter>
                    <action android:name="android.intent.action.BOOT_COMPLETED" />
                </intent-filter>
            </receiver>

            <!-- WiFi State Receiver -->
            <receiver android:name="com.wifibilling.agent.WiFiStateReceiver" android:enabled="true" android:exported="true">
                <intent-filter>
                    <action android:name="android.net.wifi.STATE_CHANGE" />
                    <action android:name="android.net.wifi.supplicant.STATE_CHANGE" />
                </intent-filter>
            </receiver>
        </config-file>

        <!-- Source Files -->
        <source-file src="src/android/WiFiBillingAgentPlugin.java" target-dir="src/com/wifibilling/agent" />
        <source-file src="src/android/WiFiBillingService.java" target-dir="src/com/wifibilling/agent" />
        <source-file src="src/android/GossipService.java" target-dir="src/com/wifibilling/agent" />
        <source-file src="src/android/SessionMonitorService.java" target-dir="src/com/wifibilling/agent" />
        <source-file src="src/android/BootReceiver.java" target-dir="src/com/wifibilling/agent" />
        <source-file src="src/android/WiFiStateReceiver.java" target-dir="src/com/wifibilling/agent" />
        <!-- WiFiWizard2 Enhanced Core (ported and enhanced) -->
        <source-file src="src/android/wifiwizard2/WifiWizard2Core.java" target-dir="src/com/wifibilling/agent/wifiwizard2" />

        <!-- Agent Implementations -->
        <source-file src="src/android/agents/CoreAgent.java" target-dir="src/com/wifibilling/agent/agents" />
        <source-file src="src/android/agents/WiFiAgent.java" target-dir="src/com/wifibilling/agent/agents" />
        <source-file src="src/android/agents/BillingAgent.java" target-dir="src/com/wifibilling/agent/agents" />
        <source-file src="src/android/agents/AuthAgent.java" target-dir="src/com/wifibilling/agent/agents" />
        <source-file src="src/android/agents/NotificationAgent.java" target-dir="src/com/wifibilling/agent/agents" />

        <!-- Protocols -->
        <source-file src="src/android/protocols/GossipNode.java" target-dir="src/com/wifibilling/agent/protocols" />
        <source-file src="src/android/protocols/WebRTCDataChannel.java" target-dir="src/com/wifibilling/agent/protocols" />
        <source-file src="src/android/protocols/BluetoothMesh.java" target-dir="src/com/wifibilling/agent/protocols" />

        <!-- Utilities -->
        <source-file src="src/android/utils/StateManager.java" target-dir="src/com/wifibilling/agent/utils" />
        <source-file src="src/android/utils/CryptoUtils.java" target-dir="src/com/wifibilling/agent/utils" />
        <source-file src="src/android/utils/NetworkUtils.java" target-dir="src/com/wifibilling/agent/utils" />

        <!-- Frameworks -->
        <framework src="androidx.core:core:1.12.0" />
        <framework src="androidx.work:work-runtime:2.9.0" />
        <framework src="com.google.android.gms:play-services-location:21.0.1" />
        <framework src="org.webrtc:google-webrtc:1.0.32006" />
    </platform>

    <!-- iOS Platform -->
    <platform name="ios">
        <config-file target="config.xml" parent="/*">
            <feature name="WiFiBillingAgent">
                <param name="ios-package" value="WiFiBillingAgentPlugin"/>
            </feature>
        </config-file>

        <!-- Permissions -->
        <config-file target="*-Info.plist" parent="NSLocationWhenInUseUsageDescription">
            <string>WiFi Billing Agent needs location access to scan for billing networks</string>
        </config-file>
        <config-file target="*-Info.plist" parent="NSLocationAlwaysUsageDescription">
            <string>WiFi Billing Agent needs background location for session monitoring</string>
        </config-file>
        <config-file target="*-Info.plist" parent="NSLocalNetworkUsageDescription">
            <string>WiFi Billing Agent needs local network access for peer-to-peer billing sync</string>
        </config-file>
        <config-file target="*-Info.plist" parent="NSBluetoothAlwaysUsageDescription">
            <string>WiFi Billing Agent uses Bluetooth for mesh networking when WiFi is unavailable</string>
        </config-file>

        <!-- Hotspot Configuration -->
        <config-file target="*-Entitlements-Debug.plist" parent="com.apple.developer.networking.wifi-info">
            <true/>
        </config-file>
        <config-file target="*-Entitlements-Release.plist" parent="com.apple.developer.networking.wifi-info">
            <true/>
        </config-file>

        <!-- Source Files -->
        <source-file src="src/ios/WiFiBillingAgentPlugin.m" />
        <source-file src="src/ios/WiFiBillingAgentPlugin.h" />
        <source-file src="src/ios/WiFiBillingService.m" />
        <source-file src="src/ios/WiFiBillingService.h" />
        <source-file src="src/ios/GossipService.m" />
        <source-file src="src/ios/GossipService.h" />
        <source-file src="src/ios/SessionMonitor.m" />
        <source-file src="src/ios/SessionMonitor.h" />

        <!-- Agents -->
        <source-file src="src/ios/agents/CoreAgent.m" />
        <source-file src="src/ios/agents/CoreAgent.h" />
        <source-file src="src/ios/agents/WiFiAgent.m" />
        <source-file src="src/ios/agents/WiFiAgent.h" />
        <source-file src="src/ios/agents/BillingAgent.m" />
        <source-file src="src/ios/agents/BillingAgent.h" />
        <source-file src="src/ios/agents/AuthAgent.m" />
        <source-file src="src/ios/agents/AuthAgent.h" />

        <!-- Frameworks -->
        <framework src="NetworkExtension.framework" />
        <framework src="SystemConfiguration.framework" />
        <framework src="CoreLocation.framework" />
        <framework src="CoreBluetooth.framework" />
        <framework src="WebKit.framework" />
        <framework src="libwebrtc.a" />
    </platform>

    <!-- Dependencies -->
    <dependency id="cordova-plugin-device" version="^2.0.0" />
    <dependency id="cordova-plugin-network-information" version="^3.0.0" />
</plugin>