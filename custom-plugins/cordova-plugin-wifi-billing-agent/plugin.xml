<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android"
        id="cordova-plugin-wifi-billing-agent" version="4.0.1">
    <name>AgentOS Mobile Connectivity Agent</name>
    <description>Cross-platform mobile connectivity, device, session, and authorized workflow capabilities for AgentOS.</description>
    <license>MIT</license>
    <keywords>cordova,wifi,connectivity,device,agent,gossip,mesh,ai,orchestration</keywords>

    <js-module src="www/WifiBillingAgent.js" name="WiFiBillingAgent">
        <clobbers target="WiFiBillingAgent" />
        <clobbers target="cordova.plugins.WiFiBillingAgent" />
    </js-module>
    <js-module src="www/WiFiWizard2Compat.js" name="WiFiWizard2Compat">
        <clobbers target="WifiWizard2" />
        <clobbers target="cordova.plugins.WifiWizard2" />
    </js-module>

    <js-module src="www/agents/CoreAgent.js" name="CoreAgent"><runs /></js-module>
    <js-module src="www/agents/EventBus.js" name="EventBus"><runs /></js-module>
    <js-module src="www/agents/StateManager.js" name="StateManager"><runs /></js-module>
    <js-module src="www/agents/WiFiAgent.js" name="WiFiAgent"><runs /></js-module>
    <js-module src="www/agents/ConnectionManager.js" name="ConnectionManager"><runs /></js-module>
    <js-module src="www/agents/NetworkScanner.js" name="NetworkScanner"><runs /></js-module>
    <js-module src="www/agents/BillingAgent.js" name="BillingAgent"><runs /></js-module>
    <js-module src="www/agents/UsageTracker.js" name="UsageTracker"><runs /></js-module>
    <js-module src="www/agents/RateCalculator.js" name="RateCalculator"><runs /></js-module>
    <js-module src="www/agents/AuthAgent.js" name="AuthAgent"><runs /></js-module>
    <js-module src="www/agents/NotificationAgent.js" name="NotificationAgent"><runs /></js-module>
    <js-module src="www/agents/AIOrchestrator.js" name="AIOrchestrator"><runs /></js-module>
    <js-module src="www/protocols/GossipNode.js" name="GossipNode"><runs /></js-module>
    <js-module src="www/protocols/PeerManager.js" name="PeerManager"><runs /></js-module>
    <js-module src="www/protocols/VectorClock.js" name="VectorClock"><runs /></js-module>
    <js-module src="www/utils/CryptoUtils.js" name="CryptoUtils"><runs /></js-module>
    <js-module src="www/utils/Logger.js" name="Logger"><runs /></js-module>
    <js-module src="www/utils/NetworkUtils.js" name="NetworkUtils"><runs /></js-module>

    <platform name="android">
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="WiFiBillingAgent">
                <param name="android-package" value="com.wifibilling.agent.WiFiBillingAgentPlugin"/>
            </feature>
            <feature name="WifiWizard2">
                <param name="android-package" value="com.wifibilling.agent.WiFiBillingAgentPlugin"/>
                <param name="onload" value="true" />
            </feature>
        </config-file>

        <config-file target="AndroidManifest.xml" parent="/*">
            <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
            <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
            <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
            <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
            <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
            <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
            <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
            <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
            <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
            <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
            <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
            <uses-permission android:name="android.permission.WAKE_LOCK" />
        </config-file>

        <config-file target="AndroidManifest.xml" parent="/manifest/application">
            <service android:name="com.wifibilling.agent.WiFiBillingService" android:enabled="true" android:exported="false" android:foregroundServiceType="connectedDevice" />
            <service android:name="com.wifibilling.agent.GossipService" android:enabled="true" android:exported="false" />
            <service android:name="com.wifibilling.agent.SessionMonitorService" android:enabled="true" android:exported="false" android:foregroundServiceType="dataSync" />
            <receiver android:name="com.wifibilling.agent.BootReceiver" android:enabled="true" android:exported="false">
                <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /></intent-filter>
            </receiver>
            <receiver android:name="com.wifibilling.agent.WiFiStateReceiver" android:enabled="true" android:exported="false">
                <intent-filter>
                    <action android:name="android.net.wifi.STATE_CHANGE" />
                    <action android:name="android.net.wifi.supplicant.STATE_CHANGE" />
                </intent-filter>
            </receiver>
        </config-file>

        <source-file src="src/android/WifiBillingAgentPlugin.java" target-dir="src/com/wifibilling/agent" />
        <source-file src="src/android/WifiBillingService.java" target-dir="src/com/wifibilling/agent" />
        <source-file src="src/android/GossipService.java" target-dir="src/com/wifibilling/agent" />
        <source-file src="src/android/SessionMonitorService.java" target-dir="src/com/wifibilling/agent" />
        <source-file src="src/android/BootReceiver.java" target-dir="src/com/wifibilling/agent" />
        <source-file src="src/android/WiFiStateReceiver.java" target-dir="src/com/wifibilling/agent" />
        <source-file src="src/android/wifiwizard2/WifiWizard2Core.java" target-dir="src/com/wifibilling/agent/wifiwizard2" />
        <source-file src="src/android/agents/CoreAgent.java" target-dir="src/com/wifibilling/agent/agents" />
        <source-file src="src/android/agents/WifiAgent.java" target-dir="src/com/wifibilling/agent/agents" />
        <source-file src="src/android/agents/BillingAgent.java" target-dir="src/com/wifibilling/agent/agents" />
        <source-file src="src/android/agents/AuthAgent.java" target-dir="src/com/wifibilling/agent/agents" />
        <source-file src="src/android/agents/NotificationAgent.java" target-dir="src/com/wifibilling/agent/agents" />
        <source-file src="src/android/protocols/GossipNode.java" target-dir="src/com/wifibilling/agent/protocols" />
        <source-file src="src/android/protocols/WebRTCDataChannel.java" target-dir="src/com/wifibilling/agent/protocols" />
        <source-file src="src/android/protocols/BluetoothMesh.java" target-dir="src/com/wifibilling/agent/protocols" />
        <source-file src="src/android/utils/StateManager.java" target-dir="src/com/wifibilling/agent/utils" />
        <source-file src="src/android/utils/CryptoUtils.java" target-dir="src/com/wifibilling/agent/utils" />
        <source-file src="src/android/utils/NetworkUtils.java" target-dir="src/com/wifibilling/agent/utils" />
        <framework src="androidx.core:core:1.12.0" />
        <framework src="androidx.work:work-runtime:2.9.0" />
        <framework src="com.google.android.gms:play-services-location:21.0.1" />
        <framework src="org.webrtc:google-webrtc:1.0.32006" />
    </platform>

    <platform name="ios">
        <config-file target="config.xml" parent="/*">
            <feature name="WiFiBillingAgent"><param name="ios-package" value="WiFiBillingAgentPlugin"/></feature>
        </config-file>
        <config-file target="*-Info.plist" parent="NSLocationWhenInUseUsageDescription"><string>AgentOS uses location only when required by platform connectivity APIs.</string></config-file>
        <config-file target="*-Info.plist" parent="NSLocalNetworkUsageDescription"><string>AgentOS uses local network access for authorized device connectivity workflows.</string></config-file>
        <config-file target="*-Info.plist" parent="NSBluetoothAlwaysUsageDescription"><string>AgentOS uses Bluetooth only for authorized local connectivity workflows.</string></config-file>
        <config-file target="*-Entitlements-Debug.plist" parent="com.apple.developer.networking.wifi-info"><true/></config-file>
        <config-file target="*-Entitlements-Release.plist" parent="com.apple.developer.networking.wifi-info"><true/></config-file>
        <source-file src="src/ios/WifiBillingAgentPlugin.m" />
        <source-file src="src/ios/WiFiBillingAgentPlugin.h" />
        <source-file src="src/ios/WiFiBillingService.m" />
        <source-file src="src/ios/WiFiBillingService.h" />
        <source-file src="src/ios/GossipService.m" />
        <source-file src="src/ios/GossipService.h" />
        <source-file src="src/ios/SessionMonitor.m" />
        <source-file src="src/ios/agents/CoreAgent.m" />
        <source-file src="src/ios/agents/CoreAgent.h" />
        <source-file src="src/ios/agents/WifiAgent.m" />
        <source-file src="src/ios/agents/WifiAgent.h" />
        <source-file src="src/ios/agents/BillingAgent.m" />
        <source-file src="src/ios/agents/BillingAgent.h" />
        <source-file src="src/ios/agents/AuthAgent.m" />
        <source-file src="src/ios/agents/AuthAgent.h" />
        <framework src="NetworkExtension.framework" />
        <framework src="SystemConfiguration.framework" />
        <framework src="CoreLocation.framework" />
        <framework src="CoreBluetooth.framework" />
        <framework src="WebKit.framework" />
        <framework src="libwebrtc.a" />
    </platform>

    <dependency id="cordova-plugin-device" version="^3.0.0" />
    <dependency id="cordova-plugin-network-information" version="^3.0.0" />
</plugin>
