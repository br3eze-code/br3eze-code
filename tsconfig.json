{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "allowJs": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/core/*"],
      "@utils/*": ["src/utils/*"],
      "@agents/*": ["agents/*"],
      "@adapters/*": ["adapters/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "extentions/**/*.ts",
    "vscode-extension/**/*.ts",
    "typings/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "www",
    "**/*.test.ts",
    "**/*.spec.ts",
    "custom-plugins/**",
    "scripts/**"
  ],
  "ts-node": {
    "esm": false,
    "transpileOnly": true
  }
}
