{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,

  "name": "br3eze-agentos",

  "buildCommand": "npm run build",
  "outputDirectory": "www",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": null,

  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  },

  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/login",   "destination": "/login.html" },
    { "source": "/l",       "destination": "/login.html" },
    { "source": "/(.*)",    "destination": "/index.html" }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "DENY" },
        { "key": "X-XSS-Protection",       "value": "1; mode=block" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://www.googleapis.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https:; connect-src 'self' https://*.firebaseio.com https://*.googleapis.com wss://*.firebaseio.com; frame-src https://accounts.google.com;"
        },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(.*\\.(?:js|css|json))",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/(.*\\.(?:png|jpg|jpeg|svg|gif|ico|webp|woff|woff2))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, immutable" }
      ]
    }
  ],

  "env": {
    "NODE_ENV": "production"
  }
}
