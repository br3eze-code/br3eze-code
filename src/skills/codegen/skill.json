{
  "name": "codegen",
    "version": "2.0.0",
  "description": "Generate supervised provider-neutral code for IoT, network, and API targets using authorized context",

  "entry": "index.js",
  "parameters": {
    "prompt": {
      "type": "string",
      "required": true,
      "description": "Natural language description of the code to generate"
    },
    "language": {
      "type": "string",
      "required": false,
      "description": "Target programming language (e.g. javascript, python, bash)",
      "enum": ["javascript", "typescript", "python", "bash", "go", "rust", "auto"],
      "default": "auto"
    },
    "framework": {
      "type": "string",
      "required": false,
      "description": "Framework or library context (e.g. express, react, fastapi)"
    },
        "target": {
      "type": "string",
      "required": false,
      "description": "Generation target",
      "enum": ["routeros", "fastapi", "python", "node"]
    },
    "provider": {
      "type": "string",
      "required": false,
      "description": "Optional provider adapter such as mikrotik, starlink, or generic-api"
    },
    "contextLevel": {
      "type": "string",
      "required": false,
      "description": "Maximum authorized context level",
      "enum": ["tenant", "domain", "site", "device", "session"]
    },
    "siteId": {
      "type": "string",
      "required": false,
      "description": "Authorized site target"
    },
    "deviceId": {
      "type": "string",
      "required": false,
      "description": "Authorized device target"
    },
    "outputFile": {

      "type": "string",
      "required": false,
      "description": "Optional file path to write the generated code to"
    }
  },
  "examples": [
    {
      "description": "Generate a Node.js Express route",
      "params": { "prompt": "REST endpoint to list users from SQLite", "language": "javascript", "framework": "express" }
    },
    {
      "description": "Generate a Python FastAPI endpoint",
      "params": { "prompt": "POST /upload endpoint with file validation", "language": "python", "framework": "fastapi" }
    }
  ],
    "tags": ["developer", "ai", "codegen", "iot", "network", "fastapi", "routeros"]

}
